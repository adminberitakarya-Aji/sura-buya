{
  "name": "@suro-buya/templates",
  "version": "0.1.0",
  "private": true,
  "description": "Template definitions for Suro-Buya universe creation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./creator": {
      "types": "./dist/creator/index.d.ts",
      "import": "./dist/creator/index.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt/index.d.ts",
      "import": "./dist/prompt/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && tsc --module CommonJS --outDir dist/cjs src/index.ts",
    "build:esm": "tsc -b",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/index.ts src/schemas/index.ts src/creator/index.ts src/engine/index.ts src/prompt/index.ts src/api/index.ts --config eslint.config.cjs --no-ignore --no-warn-ignored",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dist/cjs node_modules/.cache",
    "validate": "tsx src/validate.ts"
  },
  "dependencies": {
    "@suro-buya/shared": "workspace:*",
    "zod": "^3.22.4",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}