{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsbuildinfo",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@suro-buya/shared": ["../shared/src"],
      "@suro-buya/engine-v2": ["../engine-v2/src"],
      "@suro-buya/templates": ["../templates/universe/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist/**/*", "**/*.test.ts"],
  "references": [
    { "path": "../shared" },
    { "path": "../engine-v2" },
    { "path": "../templates/universe" },
    { "path": "../config" }
  ]
}
