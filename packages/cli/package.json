{
  "name": "@suro-buya/cli-commands",
  "version": "0.1.0",
  "private": true,
  "description": "Suro-Buya CLI Commands - Universe creation and generation tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./commands/create-universe.js": {
      "types": "./dist/commands/create-universe.d.ts",
      "import": "./dist/commands/create-universe.js",
      "require": "./dist/cjs/commands/create-universe.cjs"
    },
    "./commands/generate-scene.js": {
      "types": "./dist/commands/generate-scene.d.ts",
      "import": "./dist/commands/generate-scene.js",
      "require": "./dist/cjs/commands/generate-scene.cjs"
    },
    "./commands/generate-episode.js": {
      "types": "./dist/commands/generate-episode.d.ts",
      "import": "./dist/commands/generate-episode.js",
      "require": "./dist/cjs/commands/generate-episode.cjs"
    },
    "./commands/generate-season.js": {
      "types": "./dist/commands/generate-season.d.ts",
      "import": "./dist/commands/generate-season.js",
      "require": "./dist/cjs/commands/generate-season.cjs"
    },
    "./commands/validate-universe.js": {
      "types": "./dist/commands/validate-universe.d.ts",
      "import": "./dist/commands/validate-universe.js",
      "require": "./dist/cjs/commands/validate-universe.cjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "build:esm": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/index.ts src/commands/create-universe.ts src/commands/generate-episode.ts src/commands/generate-scene.ts src/commands/generate-season.ts src/commands/validate-universe.ts src/utils/manifest.ts src/utils/scaffold.ts --config ../../eslint.config.cjs --no-ignore --no-warn-ignored",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dist/cjs node_modules/.cache"
  },
  "dependencies": {
    "@suro-buya/engine-v2": "workspace:*",
    "@suro-buya/shared": "workspace:*",
    "@suro-buya/templates": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12",
    "fs-extra": "^11.2.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}