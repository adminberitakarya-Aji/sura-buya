{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@suro-buya/cli-commands": ["../../packages/cli/src/index.ts"],
      "@suro-buya/cli-commands/*": ["../../packages/cli/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist/cjs"],
  "references": [
    { "path": "../../packages/cli" }
  ]
}
