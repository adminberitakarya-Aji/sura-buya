{
  "name": "@suro-buya/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Suro-Buya CLI Application",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "suro-buya": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b && tsc -p tsconfig.json --module CommonJS --moduleResolution node --outDir dist/cjs",
    "build:esm": "tsc -b",
    "build:cjs": "tsc -p tsconfig.json --module CommonJS --moduleResolution node --outDir dist/cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/index.ts --config ../../eslint.config.cjs --no-ignore --no-warn-ignored",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dist/cjs node_modules/.cache"
  },
  "dependencies": {
    "@suro-buya/cli-commands": "workspace:*",
    "@suro-buya/engine-v2": "workspace:*",
    "@suro-buya/shared": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}