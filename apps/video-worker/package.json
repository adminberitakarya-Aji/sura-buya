{
  "name": "@suro-buya/video-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Suro-Buya Video Worker — Temporal-based MediaJob processing with retry & resume-on-crash (VF-3.5)",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./shared": {
      "types": "./dist/shared/interfaces.d.ts",
      "import": "./dist/shared/interfaces.js"
    }
  },
  "prisma": {
    "schema": "../web/prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:temporal": "vitest run tests/vf35-temporal-workflow.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@suro-buya/engine-v2": "workspace:*",
    "@suro-buya/shared": "workspace:*",
    "@prisma/client": "^5.10.0",
    "@temporalio/workflow": "^1.3.0",
    "@temporalio/activity": "^1.3.0",
    "@temporalio/worker": "^1.3.0",
    "@temporalio/client": "^1.3.0",
    "@temporalio/common": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.0",
    "@temporalio/testing": "^1.3.0",
    "prisma": "^5.10.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
