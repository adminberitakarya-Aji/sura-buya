# Suro-Buya Video Worker — Environment Variables (VF-3.5)
# Copy ke .env untuk development lokal

# ─────────────────────────────────────────────────────────
# DATABASE (wajib — sama dengan apps/web)
# ─────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/suro_buya_dev"

# ─────────────────────────────────────────────────────────
# TEMPORAL SERVER
# ─────────────────────────────────────────────────────────
# Development lokal: gunakan default (localhost:7233)
# Production: isi dengan alamat Temporal Cloud atau self-hosted
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
TEMPORAL_TASK_QUEUE="video-media-queue"

# mTLS untuk production Temporal Cloud
# TEMPORAL_CLIENT_CERT_PATH="/path/to/client.pem"
# TEMPORAL_CLIENT_KEY_PATH="/path/to/client.key"

# ─────────────────────────────────────────────────────────
# CLOUDFLARE R2 STORAGE (VF-5.7) - Zero-egress video storage
# Per-environment buckets: suro-buya-dev, suro-buya-staging, suro-buya-prod
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="suro-buya-dev"
R2_PUBLIC_URL=""  # Optional custom domain, e.g., https://cdn.suro-buya.com
R2_PRESIGNED_TTL_SECONDS="3600"  # 1 hour default

# ─────────────────────────────────────────────────────────
# MEDIA PROVIDER API KEYS
# ─────────────────────────────────────────────────────────
# fal.ai — dipakai Kling 3.0 (primary), Seedance 2 (fallback 1),
#           Wan 2.7 (fallback 2), Flux 2 Pro (image fallback)
# Kalau kosong: worker pakai mock provider (development without API key)
FAL_API_KEY=""

# Google Gemini — dipakai Nano Banana 2 (image primary)
# Kalau kosong: worker skip Nano Banana 2, langsung ke Flux 2 Pro
GEMINI_API_KEY=""

# ─────────────────────────────────────────────────────────
# RETRY CONFIGURATION (opsional — ada default)
# ─────────────────────────────────────────────────────────
# Max retry attempts per activity (default: 3)
# MEDIA_JOB_MAX_RETRIES=3

# Initial backoff dalam ms (default: 1000)
# MEDIA_JOB_INITIAL_BACKOFF_MS=1000

# Max backoff cap dalam ms (default: 30000)
# MEDIA_JOB_MAX_BACKOFF_MS=30000

# ─────────────────────────────────────────────────────────
# NODE_ENV
# ─────────────────────────────────────────────────────────
NODE_ENV="development"
