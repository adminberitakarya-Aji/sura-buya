# Database (wajib untuk prisma migrate/generate)
DATABASE_URL="postgresql://user:password@localhost:5432/suro_buya?schema=public"

# NextAuth (wajib untuk auth berjalan; nilai random untuk signing JWT/session)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="ganti-dengan-random-string-panjang"

# Enkripsi API key provider AI (wajib untuk fitur Settings > AI Providers)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="ganti-dengan-32-byte-random-base64"

# OAuth providers (opsional untuk dev — hanya perlu diisi kalau mau test login GitHub/Google)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare R2 Storage (VF-5.7) - Zero-egress video storage
# Per-environment buckets: suro-buya-dev, suro-buya-staging, suro-buya-prod
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="suro-buya-dev"
R2_PUBLIC_URL=""  # Optional custom domain, e.g., https://cdn.suro-buya.com
R2_PRESIGNED_TTL_SECONDS="3600"  # 1 hour default
