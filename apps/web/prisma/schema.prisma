// apps/web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  passwordHash  String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  universes     UniverseMember[]
  reviews       Review[]
  ownedUniverses Universe[] @relation("UniverseOwner")
  generationJobs GenerationJob[] @relation("GenerationJobUser")
  comments       Comment[]        @relation("CommentAuthor")
  presences      Presence[]
  comparisonSessions ComparisonSession[] @relation("ComparisonSessionUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  USER
  ADMIN
  OWNER
}

model Universe {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  manifest    Json     // universe.yaml parsed
  version     String   @default("1.0.0")
  ownerId     String
  isPublic    Boolean  @default(false)
  // VF-1.3: audiens/rating ditentukan per-universe, TIDAK ada default
  // hardcode di level engine (lihat REDESIGN-VIDEO-FACTORY.md §2.3/§2.3.1
  // dan Prinsip Desain #4). ALL_AGES dipilih sebagai default kolom murni
  // supaya universe existing (Suro & Buya, dst) tidak perlu migrasi data
  // manual saat kolom ini pertama kali ditambahkan — BUKAN pernyataan
  // bahwa platform ini defaultnya untuk anak-anak; creator universe baru
  // tetap harus mengonfirmasi/mengganti rating ini secara sadar di UI.
  contentRating   ContentRating @default(ALL_AGES)
  audienceProfile String?       @db.Text // deskripsi bebas, mis. "keluarga Indonesia, tema edukatif" — dikonsumsi persona-parser.ts & safety-review.ts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User            @relation("UniverseOwner", fields: [ownerId], references: [id])
  members          UniverseMember[]
  characters       Character[]
  bibleFiles       BibleFile[]
  episodes         Episode[]
  canonRules       CanonRule[]
  aiConfigs        AIConfig[]
  regions          Region[]         @relation("RegionUniverse")
  seasons          Season[]         @relation("SeasonUniverse")
  generationJobs   GenerationJob[]  @relation("GenerationJobUniverse")
  videoSeries      VideoSeries[]    // VF-1.3
  comments         Comment[]
  presences        Presence[]
  comparisonSessions ComparisonSession[]
}

// VF-1.3 — lihat REDESIGN-VIDEO-FACTORY.md §2.3.1
enum ContentRating {
  ALL_AGES // aman untuk segala umur, termasuk anak-anak
  TEEN     // remaja ke atas
  MATURE   // dewasa — tema berat, boleh menegangkan/kompleks
}

model UniverseMember {
  id         String        @id @default(cuid())
  userId     String
  universeId String
  role       MemberRole    @default(EDITOR)
  joinedAt   DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([userId, universeId])
}

enum MemberRole {
  OWNER
  EDITOR
  REVIEWER
  VIEWER
}

model Character {
  id           String   @id @default(cuid())
  universeId   String
  characterId  String   // "hero", "sidekick" — unique per universe
  name         String
  role         CharacterRole
  displayName  String
  description  String?  @db.Text
  coreTraits   String[] // ["brave", "curious"]
  coreWeakness String
  voiceGuide   String?  @db.Text
  bibleRef     String?  // path to bible file
  metadata     Json?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  characterAsset CharacterAsset? // VF-1.3 — lapisan visual/produksi video, opsional (tidak semua karakter dipakai di video)

  @@unique([universeId, characterId])
}

enum CharacterRole {
  PROTAGONIST
  DEUTERAGONIST
  SUPPORTING
  ANTAGONIST
  NARRATOR
}

// ============================================================
// VF-1.3 — AI Video Factory: Character Asset & Video Series
// Lihat REDESIGN-VIDEO-FACTORY.md §2.3 untuk rasional lengkap.
// Prinsip: model ini MELENGKAPI Character/Universe existing,
// TIDAK menduplikasi field persona apapun.
// ============================================================

// Lapisan visual/produksi 1:1 di atas Character (Bible) existing.
// `characterId` di sini merujuk Character.id (primary key), BUKAN
// Character.characterId (field slug internal) — dua hal yang berbeda.
model CharacterAsset {
  id              String   @id @default(cuid())
  characterId     String   @unique // FK ke Character.id
  referenceImages String[]         // URL reference image — mekanisme konsistensi visual DEFAULT (bukan LoRA)
  voiceProfile    Json?            // { provider, voiceId, settings } — lihat CharacterVisualProfile di @suro-buya/shared
  loraConfig      Json?            // opsional, hanya dipakai kalau upgrade premium di VF-6 — TIDAK dipakai di MVP
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// Menaungi beberapa video/episode dengan karakter yang sama — continuity
// naratif lintas episode. Video (VideoProject) ditambahkan di VF-2.1,
// relasi videoProjects di-append ke model ini saat itu.
model VideoSeries {
  id           String   @id @default(cuid())
  universeId   String
  title        String
  characterIds String[] // karakter utama yang muncul lintas episode series ini — reference ke Character.id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
}

model Region {
  id            String   @id @default(cuid())
  universeId    String
  regionId      String   // "jatim", "bali" — unique per universe
  name          String
  description   String?  @db.Text
  cultureGuide  String?  @db.Text
  geography     String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  universe Universe @relation("RegionUniverse", fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, regionId])
}

model Season {
  id          String   @id @default(cuid())
  universeId  String
  seasonNumber Int
  title       String
  theme       String?  @db.Text
  arcSummary  String?  @db.Text
  episodeCount Int     @default(10)
  status      SeasonStatus @default(PLANNING)
  plan        Json?    // SeasonPlan schema
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe Universe  @relation("SeasonUniverse", fields: [universeId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([universeId, seasonNumber])
}

enum SeasonStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

model Episode {
  id           String        @id @default(cuid())
  universeId   String
  seasonId     String
  episodeNumber Int
  title        String
  premise      String        @db.Text
  status       EpisodeStatus @default(PLANNING)
  plan         Json?         // EpisodePlan schema
  targetScenes Int           @default(6)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  season   Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  scenes   Scene[]

  @@unique([seasonId, episodeNumber])
}

enum EpisodeStatus {
  PLANNING
  GENERATING
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model Scene {
  id              String   @id @default(cuid())
  episodeId       String
  sceneNumber     Int
  premise         String   @db.Text
  characters      String[] // characterIds
  region          String?
  generatedText   String?  @db.Text
  blocks          Json?    // structured SceneBlock[] for the block-based editor; generatedText is kept in sync as the flattened rendering
  validationReport Json?
  version         Int      @default(1)
  status          SceneStatus @default(DRAFT)
  metadata        Json?    // token usage, model, latency, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  reviews Review[]
  versions SceneVersion[]

  @@unique([episodeId, sceneNumber])
}

enum SceneStatus {
  DRAFT
  GENERATED
  VALIDATED
  APPROVED
  REJECTED
}

model SceneVersion {
  id        String   @id @default(cuid())
  sceneId   String
  version   Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([sceneId, version])
}

model BibleFile {
  id          String        @id @default(cuid())
  universeId  String
  category    BibleCategory
  path        String        // relative path within category, e.g. "voice-protagonist.md"
  title       String
  content     String        @db.Text // raw markdown body (frontmatter excluded)
  frontmatter Json?         // parsed YAML frontmatter
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  updatedById String?

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, category, path])
}

enum BibleCategory {
  CHARACTER
  WORLD
  STORY
  VISUAL
  PRODUCTION
}

model CanonRule {
  id          String   @id @default(cuid())
  universeId  String
  ruleId      String   // "no-violence", "weakness-must-have-consequence"
  name        String
  description String   @db.Text
  ruleType    RuleType
  pattern     String?  // regex for rule-based
  severity    Severity @default(WARNING)
  isActive    Boolean  @default(true)
  metadata    Json?    // LLM judge prompt, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, ruleId])
}

enum RuleType {
  BANNED_WORD
  REQUIRED_ELEMENT
  STRUCTURE
  CHARACTER_CONSISTENCY
  CUSTOM_LLM
}

enum Severity {
  ERROR
  WARNING
  INFO
}

model AIConfig {
  id          String   @id @default(cuid())
  universeId  String
  task        AITask
  provider    String   // "anthropic", "openai", "cohere"
  model       String   // "claude-3-5-sonnet", "gpt-4o"
  apiKeyEncrypted String? // AES-256-GCM ciphertext of the API key; never store plaintext
  parameters  Json?    // temperature, maxTokens, etc.
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, task])
}

enum AITask {
  CREATIVE_GENERATION
  PLANNING
  VALIDATION
  EMBEDDING
  IMAGE_PROMPT
  CODE_GENERATION
}

model Review {
  id          String       @id @default(cuid())
  sceneId     String
  reviewerId  String
  decision    ReviewDecision
  feedback    String?      @db.Text
  annotations Json?        // inline comments
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  scene     Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  reviewer  User  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

enum ReviewDecision {
  APPROVE
  REQUEST_CHANGES
  REJECT
}

model GenerationJob {
  id          String        @id @default(cuid())
  universeId  String
  userId      String
  type        JobType
  status      JobStatus     @default(PENDING)
  input       Json
  output      Json?
  progress    Int           @default(0)
  currentStep String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  user     User     @relation("GenerationJobUser", fields: [userId], references: [id], onDelete: Cascade)
  universe Universe @relation("GenerationJobUniverse", fields: [universeId], references: [id], onDelete: Cascade)
}

enum JobType {
  SCENE_GENERATION
  EPISODE_PLANNING
  SEASON_PLANNING
  CANON_VALIDATION
  EMBEDDING_INDEX
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CommentType {
  GENERAL
  SUGGESTION
  QUESTION
}

enum CommentStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Comment {
  id           String        @id @default(cuid())
  universeId   String
  sceneId      String
  blockId      String?
  authorId     String
  content      String        @db.Text
  type         CommentType   @default(GENERAL)
  status       CommentStatus @default(OPEN)
  parentId     String?
  anchor       Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resolvedAt   DateTime?
  resolvedById String?

  author   User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")
}

model Presence {
  id         String   @id @default(cuid())
  universeId String
  userId     String
  sceneId    String?
  cursor     Json?
  color      String
  lastSeen   DateTime @default(now()) @updatedAt
  metadata   Json?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  universe Universe @relation(fields: [universeId], references: [id], onDelete: Cascade)

  @@unique([universeId, userId, sceneId], name: "universeId_userId_sceneId")
}

enum ComparisonStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ComparisonSession {
  id             String           @id @default(cuid())
  universeId     String
  name           String
  prompt         String           @db.Text
  promptVariants Json             @default("{}")
  status         ComparisonStatus @default(PENDING)
  config         Json
  winnerId       String?
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  completedAt    DateTime?

  universe Universe           @relation(fields: [universeId], references: [id], onDelete: Cascade)
  user     User               @relation("ComparisonSessionUser", fields: [createdBy], references: [id], onDelete: Cascade)
  winner   ComparisonResult?  @relation("ComparisonWinner", fields: [winnerId], references: [id])
  results  ComparisonResult[] @relation("SessionResults")
}

model ComparisonResult {
  id           String   @id @default(cuid())
  sessionId    String
  modelId      String
  modelName    String
  provider     String
  output       String   @db.Text
  tokensUsed   Int      @default(0)
  latencyMs    Int      @default(0)
  costEstimate Float    @default(0)
  scores       Json     @default("{}")
  rank         Int?
  error        String?  @db.Text
  createdAt    DateTime @default(now())

  session     ComparisonSession   @relation("SessionResults", fields: [sessionId], references: [id], onDelete: Cascade)
  wonSessions ComparisonSession[] @relation("ComparisonWinner")
} 