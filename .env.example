# Database
DATABASE_URL="postgresql://user:password@localhost:5432/suro_buya?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"

# OAuth Providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
COHERE_API_KEY=""

# File Storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 Storage (VF-5.7) - Zero-egress video storage
# Per-environment buckets: suro-buya-dev, suro-buya-staging, suro-buya-prod
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="suro-buya-dev"
R2_PUBLIC_URL=""  # Optional custom domain, e.g., https://cdn.suro-buya.com
R2_PRESIGNED_TTL_SECONDS="3600"  # 1 hour default

# Email (optional)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_COLLABORATION="false"