{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surobuya.ai/schema/workflow.schema.json",
  "title": "Workflow",
  "description": "Workflow definition and execution state for the Suro & Buya AI Engine.",
  "type": "object",

  "required": [
    "id",
    "name",
    "type",
    "executionId",
    "status",
    "stages",
    "currentStage",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "description": "Unique workflow identifier."
    },

    "name": {
      "type": "string"
    },

    "type": {
      "type": "string",
      "enum": [
        "story",
        "season",
        "episode",
        "review",
        "production"
      ]
    },

    "executionId": {
      "type": "string"
    },

    "parentWorkflowId": {
      "type": "string"
    },

    "intent": {
      "type": "string",
      "description": "Original creator intent."
    },

    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "aborted"
      ]
    },

    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },

    "currentStage": {
      "type": "string",
      "enum": [
        "intent",
        "retrieval",
        "memory",
        "planning",
        "generation",
        "validation",
        "review",
        "production",
        "completed"
      ]
    },

    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",

        "required": [
          "name",
          "order",
          "status"
        ],

        "properties": {
          "name": {
            "type": "string"
          },

          "order": {
            "type": "integer",
            "minimum": 1
          },

          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "skipped"
            ]
          },

          "startedAt": {
            "type": "string",
            "format": "date-time"
          },

          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },

          "durationMs": {
            "type": "integer",
            "minimum": 0
          },

          "retryCount": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },

    "checkpoint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },

        "lastCompletedStage": {
          "type": "string"
        },

        "checkpointId": {
          "type": "string"
        },

        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "metrics": {
      "type": "object",
      "properties": {
        "totalStages": {
          "type": "integer",
          "minimum": 0
        },

        "completedStages": {
          "type": "integer",
          "minimum": 0
        },

        "failedStages": {
          "type": "integer",
          "minimum": 0
        },

        "totalDurationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "configuration": {
      "type": "object",
      "properties": {
        "workflowVersion": {
          "type": "string"
        },

        "engineVersion": {
          "type": "string"
        },

        "configurationVersion": {
          "type": "string"
        }
      }
    },

    "metadata": {
      "type": "object",

      "required": [
        "createdAt",
        "updatedAt"
      ],

      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },

        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },

        "createdBy": {
          "type": "string"
        },

        "notes": {
          "type": "string"
        }
      }
    }
  }
}