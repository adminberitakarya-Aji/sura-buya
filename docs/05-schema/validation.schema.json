{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surobuya.ai/schema/validation.schema.json",
  "title": "Validation Report",
  "description": "Validation report generated by the Validation Runtime for Suro & Buya AI Engine.",
  "type": "object",

  "required": [
    "id",
    "executionId",
    "targetType",
    "targetId",
    "status",
    "summary",
    "results",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "description": "Unique validation report identifier."
    },

    "executionId": {
      "type": "string"
    },

    "workflowId": {
      "type": "string"
    },

    "targetType": {
      "type": "string",
      "enum": [
        "story",
        "episode",
        "scene",
        "dialogue",
        "planning",
        "production"
      ]
    },

    "targetId": {
      "type": "string"
    },

    "status": {
      "type": "string",
      "enum": [
        "pass",
        "pass_with_warning",
        "regenerate",
        "reject"
      ]
    },

    "summary": {
      "type": "object",
      "required": [
        "totalChecks",
        "passed",
        "warnings",
        "errors"
      ],
      "properties": {
        "totalChecks": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },

    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule",
          "category",
          "status"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },

          "category": {
            "type": "string",
            "enum": [
              "schema",
              "canon",
              "timeline",
              "character",
              "world",
              "story",
              "dialogue",
              "visual",
              "continuity",
              "production"
            ]
          },

          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "error"
            ]
          },

          "message": {
            "type": "string"
          },

          "location": {
            "type": "string",
            "description": "Reference to the affected object, scene, dialogue, or field."
          },

          "recommendation": {
            "type": "string"
          }
        }
      }
    },

    "violations": {
      "type": "object",
      "properties": {
        "canon": {
          "type": "integer",
          "minimum": 0
        },
        "timeline": {
          "type": "integer",
          "minimum": 0
        },
        "character": {
          "type": "integer",
          "minimum": 0
        },
        "dialogue": {
          "type": "integer",
          "minimum": 0
        },
        "continuity": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "references": {
      "type": "object",
      "properties": {
        "characterBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worldBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storyBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "nextAction": {
      "type": "string",
      "enum": [
        "continue",
        "regenerate",
        "manual_review",
        "reject"
      ]
    },

    "metadata": {
      "type": "object",
      "required": [
        "validatorVersion",
        "engineVersion",
        "validatedAt"
      ],
      "properties": {
        "validatorVersion": {
          "type": "string"
        },

        "engineVersion": {
          "type": "string"
        },

        "validatedAt": {
          "type": "string",
          "format": "date-time"
        },

        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}