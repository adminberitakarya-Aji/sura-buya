{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surobuya.ai/schema/planning.schema.json",
  "title": "Planning Blueprint",
  "description": "Planning Blueprint generated by the Planning Runtime. This blueprint serves as the execution contract for Generation Runtime.",
  "type": "object",

  "required": [
    "id",
    "version",
    "storyId",
    "episodeId",
    "goal",
    "storyPlan",
    "episodePlan",
    "scenePlans",
    "constraints",
    "status",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "description": "Unique planning identifier."
    },

    "version": {
      "type": "string"
    },

    "storyId": {
      "type": "string"
    },

    "seasonId": {
      "type": "string"
    },

    "episodeId": {
      "type": "string"
    },

    "intent": {
      "type": "string",
      "description": "Original creator intent."
    },

    "goal": {
      "type": "object",
      "required": [
        "objective",
        "targetAudience",
        "theme"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "targetAudience": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "moralMessage": {
          "type": "string"
        }
      }
    },

    "storyPlan": {
      "type": "object",
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "mainConflict": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      }
    },

    "episodePlan": {
      "type": "object",
      "required": [
        "opening",
        "middle",
        "ending"
      ],
      "properties": {
        "opening": {
          "type": "string"
        },
        "middle": {
          "type": "string"
        },
        "ending": {
          "type": "string"
        },
        "estimatedDuration": {
          "type": "integer",
          "minimum": 1
        }
      }
    },

    "scenePlans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sceneNumber",
          "objective",
          "location",
          "characters"
        ],
        "properties": {
          "sceneNumber": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflict": {
            "type": "string"
          },
          "expectedOutcome": {
            "type": "string"
          }
        }
      }
    },

    "characterAllocation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "characterId",
          "role"
        ],
        "properties": {
          "characterId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "main",
              "supporting",
              "guest",
              "background"
            ]
          }
        }
      }
    },

    "constraints": {
      "type": "object",
      "properties": {
        "followCanon": {
          "type": "boolean",
          "default": true
        },
        "allowNewCharacter": {
          "type": "boolean",
          "default": false
        },
        "allowTimelineChange": {
          "type": "boolean",
          "default": false
        },
        "allowWorldModification": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "references": {
      "type": "object",
      "properties": {
        "characterBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "worldBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storyBible": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "approved",
        "rejected"
      ]
    },

    "metadata": {
      "type": "object",
      "required": [
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "plannerVersion": {
          "type": "string"
        },
        "engineVersion": {
          "type": "string"
        }
      }
    }
  }
}