{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surobuya.ai/schema/execution.schema.json",
  "title": "Execution",
  "description": "Execution context for a single AI Engine run.",
  "type": "object",

  "required": [
    "id",
    "workflowId",
    "intent",
    "status",
    "currentRuntime",
    "configuration",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "description": "Unique execution identifier."
    },

    "workflowId": {
      "type": "string"
    },

    "parentExecutionId": {
      "type": "string"
    },

    "intent": {
      "type": "string",
      "description": "Original creator request."
    },

    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "running",
        "paused",
        "completed",
        "failed",
        "cancelled",
        "aborted"
      ]
    },

    "currentRuntime": {
      "type": "string",
      "enum": [
        "orchestrator",
        "workflow",
        "retrieval",
        "memory",
        "planning",
        "generation",
        "validation",
        "review",
        "production",
        "completed"
      ]
    },

    "currentTask": {
      "type": "string"
    },

    "configuration": {
      "type": "object",
      "required": [
        "engineVersion",
        "configurationVersion"
      ],
      "properties": {
        "engineVersion": {
          "type": "string"
        },
        "configurationVersion": {
          "type": "string"
        },
        "promptLibraryVersion": {
          "type": "string"
        },
        "canonVersion": {
          "type": "string"
        }
      }
    },

    "checkpoint": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "checkpointId": {
          "type": "string"
        },
        "lastRuntime": {
          "type": "string"
        },
        "lastStage": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "retry": {
      "type": "object",
      "properties": {
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxRetry": {
          "type": "integer",
          "minimum": 0
        },
        "lastRetryAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "metrics": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "tokenUsage": {
          "type": "integer",
          "minimum": 0
        },
        "runtimeCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "artifacts": {
      "type": "object",
      "properties": {
        "planningId": {
          "type": "string"
        },
        "episodeId": {
          "type": "string"
        },
        "reviewId": {
          "type": "string"
        },
        "productionId": {
          "type": "string"
        }
      }
    },

    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "runtime",
          "event"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "runtime": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          }
        }
      }
    },

    "metadata": {
      "type": "object",
      "required": [
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}