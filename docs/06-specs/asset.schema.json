{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suro-buya.dev/schema/asset.schema.json",
  "title": "Asset",
  "description": "Canonical Asset object for the Suro & Buya AI Engine.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "id",
    "version",
    "status",
    "type",
    "name",
    "source",
    "ownership",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AST-[A-Z0-9_-]+$"
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "published",
        "archived"
      ]
    },

    "type": {
      "type": "string",
      "enum": [
        "script",
        "storyboard",
        "image",
        "character-image",
        "background",
        "voice",
        "music",
        "sound-effect",
        "video",
        "animation",
        "subtitle",
        "thumbnail",
        "document",
        "other"
      ]
    },

    "name": {
      "type": "string"
    },

    "description": {
      "type": "string"
    },

    "source": {
      "$ref": "#/$defs/source"
    },

    "ownership": {
      "$ref": "#/$defs/ownership"
    },

    "references": {
      "$ref": "#/$defs/references"
    },

    "technical": {
      "$ref": "#/$defs/technical"
    },

    "generation": {
      "$ref": "#/$defs/generation"
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },

  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "uri"
      ],

      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },

        "storage": {
          "type": "string",
          "enum": [
            "local",
            "cloud",
            "repository",
            "cdn"
          ]
        },

        "checksum": {
          "type": "string"
        },

        "mimeType": {
          "type": "string"
        },

        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "ownership": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "createdBy"
      ],

      "properties": {
        "createdBy": {
          "type": "string"
        },

        "owner": {
          "type": "string"
        },

        "license": {
          "type": "string"
        },

        "copyright": {
          "type": "string"
        }
      }
    },

    "references": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "storyId": {
          "type": "string",
          "pattern": "^STR-[A-Z0-9_-]+$"
        },

        "seasonId": {
          "type": "string",
          "pattern": "^SEA-[A-Z0-9_-]+$"
        },

        "episodeId": {
          "type": "string",
          "pattern": "^EPI-[A-Z0-9_-]+$"
        },

        "sceneId": {
          "type": "string",
          "pattern": "^SCN-[A-Z0-9_-]+$"
        },

        "characterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHR-[A-Z0-9_-]+$"
          }
        }
      }
    },

    "technical": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "format": {
          "type": "string"
        },

        "resolution": {
          "type": "string"
        },

        "duration": {
          "type": "string"
        },

        "frameRate": {
          "type": "number"
        },

        "sampleRate": {
          "type": "integer"
        },

        "bitrate": {
          "type": "string"
        },

        "language": {
          "type": "string"
        }
      }
    },

    "generation": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "generatedBy": {
          "type": "string"
        },

        "model": {
          "type": "string"
        },

        "promptVersion": {
          "type": "string"
        },

        "seed": {
          "type": "integer"
        },

        "generationDate": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "createdAt",
        "updatedAt",
        "createdBy"
      ],

      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },

        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },

        "createdBy": {
          "type": "string"
        },

        "reviewedBy": {
          "type": "string"
        },

        "approvedBy": {
          "type": "string"
        }
      }
    }
  }
}