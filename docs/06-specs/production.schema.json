{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suro-buya.dev/schema/production.schema.json",
  "title": "Production Package",
  "description": "Canonical Production Package object for the Suro & Buya AI Engine.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "id",
    "version",
    "status",
    "episodeId",
    "productionStage",
    "assets",
    "qualityAssurance",
    "publishing",
    "metadata"
  ],

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PRD-[A-Z0-9_-]+$"
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "production",
        "published",
        "archived"
      ]
    },

    "episodeId": {
      "type": "string",
      "pattern": "^EPI-[A-Z0-9_-]+$"
    },

    "productionStage": {
      "type": "string",
      "enum": [
        "script",
        "storyboard",
        "visual",
        "voice",
        "editing",
        "quality-assurance",
        "publishing",
        "completed"
      ]
    },

    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^AST-[A-Z0-9_-]+$"
      },
      "uniqueItems": true
    },

    "qualityAssurance": {
      "$ref": "#/$defs/qualityAssurance"
    },

    "publishing": {
      "$ref": "#/$defs/publishing"
    },

    "productionNotes": {
      "type": "string"
    },

    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/history"
      }
    },

    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },

  "$defs": {
    "qualityAssurance": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "status"
      ],

      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },

        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },

        "approvedBy": {
          "type": "string"
        },

        "approvedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "issue": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "severity",
        "message"
      ],

      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ]
        },

        "message": {
          "type": "string"
        },

        "recommendation": {
          "type": "string"
        }
      }
    },

    "publishing": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not-scheduled",
            "scheduled",
            "published"
          ]
        },

        "platform": {
          "type": "string"
        },

        "publishAt": {
          "type": "string",
          "format": "date-time"
        },

        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },

        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },

    "history": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "timestamp",
        "stage"
      ],

      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },

        "stage": {
          "type": "string"
        },

        "actor": {
          "type": "string"
        },

        "notes": {
          "type": "string"
        }
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "createdAt",
        "updatedAt",
        "createdBy"
      ],

      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },

        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },

        "createdBy": {
          "type": "string"
        },

        "reviewedBy": {
          "type": "string"
        },

        "approvedBy": {
          "type": "string"
        }
      }
    }
  }
}